FROM node:24-bookworm-slim

ENV NODE_ENV=production
ENV SERVER_TRUST_BOUNDARY_HOST=0.0.0.0
ENV SERVER_TRUST_BOUNDARY_PORT=8787

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci --omit=dev

COPY server-domain ./server-domain
COPY server-trust-boundary ./server-trust-boundary

USER node

EXPOSE 8787

HEALTHCHECK \
  --interval=30s \
  --timeout=5s \
  --start-period=10s \
  --retries=3 \
  CMD node -e 'fetch("http://127.0.0.1:8787/health").then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))'

CMD ["node", "server-trust-boundary/server.js"]
