#!/bin/bash
set -e

LABEL="care.risen.connector"
PLIST="/Library/LaunchAgents/${LABEL}.plist"
INSTALL_DIR="/Library/Application Support/RISEN CARE Connector"

/bin/chmod 755 \
  "${INSTALL_DIR}/runtime/node" \
  "${INSTALL_DIR}/native/macos/risen-keychain-helper" \
  "${INSTALL_DIR}/scripts/production-local-runtime.sh"

/bin/chmod 644 \
  "${PLIST}"

exit 0
